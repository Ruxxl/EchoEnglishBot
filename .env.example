# Telegram-бот: токен от @BotFather
BOT_TOKEN=

# HTTPS-адрес, на котором отдаётся папка webapp/ (backend отдаёт её сам на "/")
# Telegram принимает в кнопке WebApp только https-домен, не localhost
WEBAPP_URL=https://your-domain.example/

# Ключ Google Gemini API (бесплатный tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Numeric Telegram id преподавателя (узнать можно у @userinfobot) — доступ к админке,
# /news в боте, уведомления о сообщениях учеников в чате "Преподаватель".
TEACHER_CHAT_ID=998292747

# По умолчанию — локальный SQLite. Для продакшена укажите Postgres, например:
# postgresql+asyncpg://user:password@localhost:5432/echo_english
DATABASE_URL=sqlite+aiosqlite:///./echo_english.db

# Speaking Practice — живой голосовой ИИ-экзаменатор (backend/services/speaking_agent.py):
# LiveKit Cloud (бесплатный Build-тариф, без карты) — https://cloud.livekit.io -> Settings -> API keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Deepgram (STT+TTS, $200 бесплатных кредитов, без карты) — https://console.deepgram.com
DEEPGRAM_API_KEY=
# Groq (LLM, бесплатный тир, без карты) — https://console.groq.com/keys
GROQ_API_KEY=
