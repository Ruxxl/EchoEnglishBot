# Telegram-бот: токен от @BotFather
BOT_TOKEN=

# HTTPS-адрес, на котором отдаётся папка webapp/ (backend отдаёт её сам на "/")
# Telegram принимает в кнопке WebApp только https-домен, не localhost
WEBAPP_URL=https://your-domain.example/

# Ключ Google Gemini API (бесплатный tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Numeric Telegram id преподавателя (узнать можно у @userinfobot) — доступ к админке,
# /news в боте, уведомления о сообщениях учеников в чате "Преподаватель".
TEACHER_CHAT_ID=998292747

# По умолчанию — локальный SQLite. Для продакшена укажите Postgres, например:
# postgresql+asyncpg://user:password@localhost:5432/echo_english
DATABASE_URL=sqlite+aiosqlite:///./echo_english.db

# Speaking Practice — живой голосовой ИИ-экзаменатор. Работает как ОТДЕЛЬНЫЙ сервис
# (backend/agent_worker.py, запускается через render.yaml сервисом echo-english-speaking-agent) —
# вместе с ботом/FastAPI он не помещался в 512MB free-инстанса Render и падал по OOM.
#
# LIVEKIT_* нужны в ОБОИХ сервисах: основному — чтобы выдавать токен на вход в комнату
# (backend/routers/speaking.py), агенту — чтобы туда подключиться.
# LiveKit Cloud (бесплатный Build-тариф, без карты) — https://cloud.livekit.io -> Settings -> API keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Deepgram (STT+TTS, $200 бесплатных кредитов, без карты) — https://console.deepgram.com.
# Нужен только сервису-агенту.
DEEPGRAM_API_KEY=
# Groq (LLM, бесплатный тир, без карты) — https://console.groq.com/keys. Нужен только агенту.
GROQ_API_KEY=
# Общий секрет: агент подписывает им POST-запрос с результатом звонка обратно на основной
# сервис (у агента нет доступа к SQLite основного сервиса — свой диск). Один и тот же
# случайный секрет в обоих сервисах, например: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_CALLBACK_SECRET=
# Только у сервиса-агента: публичный URL основного сервиса (куда слать этот POST).
SPEAKING_API_BASE_URL=
